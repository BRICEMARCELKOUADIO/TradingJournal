{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TradingJournal",
    "Audience": "TradingJournal.Client",
    "LifetimeMinutes": 15
  },
  "TradeImages": {
    "MaxImagesPerTrade": 10,
    "PutUrlSeconds": 300,
    "GetUrlSeconds": 120,
    "UploadLifetimeMinutes": 15,
    "S3": {
      "Enabled": false,
      "BucketName": "",
      "Region": "",
      "CleanupEnabled": true
    }
  },
  "AuthRateLimiting": {
    "LoginPermitLimit": 5,
    "RegisterPermitLimit": 5,
    "WindowSeconds": 60
  }
}
